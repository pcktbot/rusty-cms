# API
CMS_API_HOST=127.0.0.1
CMS_API_PORT=4000
CMS_REQUIRE_DATABASE=false
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rusty_cms

# Temporal
TEMPORAL_UI_URL=http://localhost:8233
TEMPORAL_GRPC_ENDPOINT=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_RUNNER_PYTHON=/absolute/path/to/test-cms-rewrite/workers/temporal_runner/.venv/bin/python
TEMPORAL_RUNNER_START_SCRIPT=/absolute/path/to/test-cms-rewrite/workers/temporal_runner/start_workflow.py
TEMPORAL_RUNNER_RESULT_SCRIPT=/absolute/path/to/test-cms-rewrite/workers/temporal_runner/get_workflow_result.py
CMS_MIGRATION_CA_BUNDLE=
CMS_MIGRATION_ALLOW_INSECURE_TLS=false

# AI provider selection
CMS_AI_PROVIDER=mock
CMS_AI_ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_API_KEY=
CMS_AI_VERTEX_PROJECT=
CMS_AI_VERTEX_LOCATION=us-central1
CMS_AI_VERTEX_MODEL=gemini-2.5-flash

# LangSmith
CMS_AI_ENABLE_LANGSMITH=false
CMS_AI_ENABLE_LANGSMITH_TRACING=false
CMS_AI_ENABLE_LANGSMITH_EVALS=false
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rusty-cms
